services:
  caddy:
    build: .
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    environment:
      # Cloudflare API token for DNS-01 ACME challenges
      - CLOUDFLARE_API_TOKEN=${CLOUDFLARE_API_TOKEN}
      - CLOUDFLARE_DNS_API_TOKEN=${CLOUDFLARE_DNS_API_TOKEN}
    volumes:
      - ./conf:/etc/caddy
      - caddy_data:/data
      - caddy_config:/config
    # Caddy runs as a non-root user; the binary carries cap_net_bind_service
    # (set via setcap in the Dockerfile), so it can bind 80/443 without root.
    cap_add:
      - NET_BIND_SERVICE

volumes:
  caddy_data:
  caddy_config:
